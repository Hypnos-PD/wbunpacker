{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sva.hypd.asia/contracts/pipeline.schema.json",
  "title": "svwb pipeline manifest",
  "type": "object",
  "required": [
    "version",
    "groups",
    "steps"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "env_file": {
      "type": "string"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "groups": {
      "type": "object",
      "required": [
        "data",
        "media",
        "site",
        "catalog"
      ],
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/group"
        },
        "media": {
          "$ref": "#/$defs/group"
        },
        "site": {
          "$ref": "#/$defs/group"
        },
        "catalog": {
          "$ref": "#/$defs/group"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "group": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string"
        },
        "env": {
          "$ref": "#/$defs/environment"
        }
      }
    },
    "optionalArgs": {
      "type": "object",
      "required": [
        "when_env",
        "args"
      ],
      "properties": {
        "when_env": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "command"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "description": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "$ref": "#/$defs/environment"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional_args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/optionalArgs"
          }
        }
      }
    }
  }
}
